# Adapted from Scientific Visualization's publication.mplstyle (MIT skill).
# General screen/report style, not a journal-compliance claim.
figure.facecolor: white
axes.facecolor: white
font.family: sans-serif
font.sans-serif: DejaVu Sans
font.size: 11
axes.titlesize: 12
axes.labelsize: 11
axes.spines.top: False
axes.spines.right: False
axes.axisbelow: True
axes.linewidth: 0.7
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9
legend.frameon: False
lines.linewidth: 1.8
lines.markersize: 5
savefig.dpi: 300
savefig.facecolor: white
savefig.transparent: False
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
